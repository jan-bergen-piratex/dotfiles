#!/usr/bin/env python3
import json
import subprocess
import sys
import time
from datetime import datetime, timezone


CLIENT_NAME = "jan_codex_rate_limits_json"


def iso_utc(epoch):
    return datetime.fromtimestamp(epoch, tz=timezone.utc).isoformat().replace("+00:00", "Z")


def iso_local(epoch):
    return datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


def rpc_call():
    proc = subprocess.Popen(
        ["codex", "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )

    def send(message):
        proc.stdin.write(json.dumps(message) + "\n")
        proc.stdin.flush()

    send(
        {
            "id": 0,
            "method": "initialize",
            "params": {
                "clientInfo": {
                    "name": CLIENT_NAME,
                    "title": "Jan Codex Rate Limits JSON",
                    "version": "0.1.0",
                },
                "capabilities": {"experimentalApi": True},
            },
        }
    )
    send({"method": "initialized", "params": {}})
    send({"id": 1, "method": "account/rateLimits/read", "params": None})

    deadline = time.time() + 20
    result = None
    while time.time() < deadline:
        line = proc.stdout.readline()
        if not line:
            break
        msg = json.loads(line)
        if msg.get("id") == 1:
            if "error" in msg:
                raise RuntimeError(msg["error"])
            result = msg.get("result")
            break

    proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()

    if result is None:
        raise RuntimeError("no rate limit response from codex app-server")
    return result


def normalize_window(name, data):
    if not data:
        return None

    used = int(data.get("usedPercent") or 0)
    resets_at = data.get("resetsAt")
    resets_epoch = int(resets_at) if resets_at is not None else None
    now = int(time.time())

    return {
        "name": name,
        "used_percent": used,
        "remaining_percent": max(0, 100 - used),
        "window_duration_mins": data.get("windowDurationMins"),
        "resets_at_epoch": resets_epoch,
        "resets_at_utc": iso_utc(resets_epoch) if resets_epoch is not None else None,
        "resets_at_local": iso_local(resets_epoch) if resets_epoch is not None else None,
        "resets_in_seconds": max(0, resets_epoch - now) if resets_epoch is not None else None,
    }


def main():
    try:
        result = rpc_call()
        by_id = (result or {}).get("rateLimitsByLimitId") or {}
        output = {
            "ok": True,
            "generated_at_epoch": int(time.time()),
            "generated_at_utc": iso_utc(int(time.time())),
            "source": "codex account/rateLimits/read",
            "context_window_usage_percent": None,
            "context_window_usage_source": "not exposed by account/rateLimits/read",
            "limits": {},
        }

        for limit_id, limit in by_id.items():
            output["limits"][limit_id] = {
                "limit_id": limit.get("limitId") or limit_id,
                "limit_name": limit.get("limitName"),
                "plan_type": limit.get("planType"),
                "credits": limit.get("credits"),
                "rate_limit_reached_type": limit.get("rateLimitReachedType"),
                "windows": {
                    "primary": normalize_window("primary", limit.get("primary")),
                    "secondary": normalize_window("secondary", limit.get("secondary")),
                },
            }

        print(json.dumps(output, indent=2, sort_keys=True))
        return 0
    except Exception as exc:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": str(exc),
                    "generated_at_epoch": int(time.time()),
                    "generated_at_utc": iso_utc(int(time.time())),
                    "source": "codex account/rateLimits/read",
                    "context_window_usage_percent": None,
                    "context_window_usage_source": "not exposed by account/rateLimits/read",
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
