#!/usr/bin/env fish

set -l session

if test (count $argv) -gt 0
    if test "$argv[1]" = "-h"; or test "$argv[1]" = "--help"
        echo "usage: codex-tmux [session-name] [initial-prompt]"
        echo "default session-name: current tmux window name"
        exit 0
    end

    set session $argv[1]
    set -e argv[1]
else if set -q TMUX
    set session (tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null)
end

if test -z "$session"
    echo "codex-tmux: pass a session name or run inside tmux" >&2
    exit 2
end

set -l resume_target "$session"
set -l index "$HOME/.codex/session_index.jsonl"

if test -f "$index"
    while read -l line
        if string match -q "*\"thread_name\":\"$session\"*" "$line"
            set -l id (string replace -r '^.*"id":"([^"]+)".*$' '$1' -- "$line")
            if test -n "$id"; and test "$id" != "$line"
                set resume_target "$id"
            end
        end
    end < "$index"
end

# `codex resume --all` only affects the picker. For named resumes, pass the
# UUID from Codex's session index so cwd filtering cannot hide the session.
# Restored tmux Codex sessions should resume in yolo mode.
exec codex resume --dangerously-bypass-approvals-and-sandbox "$resume_target" $argv
